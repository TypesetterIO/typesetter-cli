{
    "name": "typesetterio/typesetter-cli",
    "description": "Create PDFs from markdown with PHP.",
    "keywords": ["markdown", "pdf", "ebook", "book", "mpdf", "commonmark", "cli"],
    "homepage": "https://typesetter.io",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Aaron Saray",
            "homepage": "https://aaronsaray.com"
        }
    ],
    "support": {
        "docs": "https://typesetter.io/docs.html"
    },
    "require": {
        "php": "^8.4",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "typesetterio/typesetter": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": "php-cs-fixer check --show-progress=none",
        "phpcs-fix": "php-cs-fixer fix --show-progress=none",
        "phpstan": "phpstan",
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-html coverage --path-coverage"
        ],
        "ci": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "phpcs": "Check coding standard with PHP CS Fixer",
        "phpcs-fix": "Fix coding standard with PHP CS Fixer",
        "phpstan": "Run PHPStan",
        "test": "Run the PHPUnit tests",
        "coverage": "Write an HTML coverage report",
        "ci": "Run all CI tests"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["typesetter"]
}
